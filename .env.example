# ============================================================
# Clubo environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---------- Firebase (client / browser) ----------
# Firebase Console > Project settings > General > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only) ----------
# Firebase Console > Project settings > Service accounts > Generate new private key
# Paste values from the downloaded JSON. Keep the \n in the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Instagram scraping (Apify) ----------
# https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/instagram-post-scraper
# Shared secret so only Apify can call our ingest webhook
APIFY_WEBHOOK_SECRET=

# ---------- LLM (extraction + chat) ----------
# Set LLM_PROVIDER to "anthropic" or "openai", then fill the matching key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
EXTRACTION_MODEL=
CHAT_MODEL=

# ---------- Embeddings (vector search) ----------
# "openai" (uses OPENAI_API_KEY) or "vertex" (uses the Firebase/GCP project)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Random long string used to sign unsubscribe links
UNSUBSCRIBE_SECRET=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get the admin claim on first login
ADMIN_EMAILS=
# Chat messages allowed per user per day
CHAT_DAILY_LIMIT=30

# ---------- Vercel Cron ----------
# Vercel sends this as a Bearer token to /api/cron/*
CRON_SECRET=

# ---------- Vercel Blob (posters) ----------
# Created automatically when you connect a Blob store to the Vercel project
BLOB_READ_WRITE_TOKEN=

# ---------- Email (SMTP, e.g. Gmail with an App Password) ----------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
